APP_ENV=development
APP_BASE_URL=http://localhost:3000
APP_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
API_BIND_HOST=0.0.0.0
WEB_BIND_HOST=0.0.0.0

POSTGRES_URL=postgresql+psycopg://doc_translator:doc_translator@postgres:5432/doc_translator
REDIS_URL=redis://redis:6379/0

STORAGE_MODE=local
LOCAL_STORAGE_PATH=/data/files
FILE_RETENTION_DAYS=7

MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=replace-me
MODEL_NAME=gpt-4.1-mini
MODEL_TIMEOUT_SECONDS=120

OCR_ENABLED=true
OCR_LANGUAGE_HINT=auto

MAX_UPLOAD_MB=100
MAX_CONCURRENT_JOBS=10

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Administrator

LOG_LEVEL=INFO

# ---- PDF layout convergence: per-rule hook policy ----
# Each rule can be set to: apply | observe | off
#   apply   = run and mutate the document (legacy behaviour)
#   observe = run the plan stage, record to sidecar with decision=observed, do NOT mutate
#   off     = skip entirely (no plan, no sidecar event)
# text_only / style_only / render default to "apply"; structure defaults to
# "observe" (see docs/pdf-layout-convergence-plan.md, M1b). Override per rule:
# PDF_HOOK_STRUCTURE_NORMALIZE_FRAGMENTED=observe
# PDF_HOOK_STRUCTURE_MERGE_SAME_LINE_FRAGMENT_BRIDGE=apply
# PDF_HOOK_STRUCTURE_SPLIT_WRAPPED_SAME_LINE_TAIL=apply
# PDF_HOOK_STRUCTURE_MERGE_SAME_LINE=observe
# PDF_HOOK_STRUCTURE_REMOVE_SUBSUMED=observe
# PDF_HOOK_STRUCTURE_COLLAPSE_OVERLAP=observe
# PDF_HOOK_STRUCTURE_SPLIT_NUMBERED_LISTS=observe
# PDF_HOOK_STRUCTURE_RECONCILE_REPEATED_EDGE=observe
# PDF_HOOK_STYLE_RESTORE_VERTICAL_LAYOUT=apply
# PDF_HOOK_STYLE_NORMALIZE_BODY_FONT_SIZES=apply
# PDF_HOOK_STYLE_NORMALIZE_PDF_FONT_TRAITS=apply
# PDF_HOOK_RENDER_AXIS_LABEL=apply
